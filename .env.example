# Load with: set -a; source .env; set +a
# Paths are relative to the repo root.

# Pick the mode first: "test" (Zcash testnet, THORChain simulated) or "main" (real THORChain).
# Each network keeps its own files under ./<network>/:
#   wallet/ (seed encrypted to identity.txt), identity.txt, slices.sqlite (back this up)
SLP_NETWORK=test

# Optional overrides of the per-network defaults:
# SLP_WALLET_DIR=./test/wallet
# SLP_IDENTITY=./test/identity.txt
# SLP_STATE=./test/slices.sqlite

# BIP-44 account reserved for slice addresses (the testnet vault uses this + 1).
# Never change it after the first plan.
SLP_SLICE_ACCOUNT=1000

THORNODE_URL=https://gateway.liquify.com/chain/thorchain_api
MIDGARD_URL=https://gateway.liquify.com/chain/thorchain_midgard

# Dashboard only (defaults shown)
# SLP_BIN=./target/release/slp
# SLP_CWD=<repo root>
