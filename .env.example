# Load with: set -a; source .env; set +a
# Paths are relative to the repo root.

# Wallet created with `slp wallet -w ./wallet init|restore-mnemonic ... -n main`
SLP_WALLET_DIR=./wallet
# age identity that decrypts the wallet seed. Keep it off shared disks.
SLP_IDENTITY=./identity.txt
# Slice state. Back this file up.
SLP_STATE=./slices.sqlite
# BIP-44 account reserved for slice addresses. Never change it after the first plan.
SLP_SLICE_ACCOUNT=1000

THORNODE_URL=https://gateway.liquify.com/chain/thorchain_api
MIDGARD_URL=https://gateway.liquify.com/chain/thorchain_midgard

# Dashboard only (defaults shown)
# SLP_BIN=./target/release/slp
# SLP_CWD=<repo root>
